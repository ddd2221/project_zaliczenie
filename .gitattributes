# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Enforce LF for all shell scripts so Docker builds on Windows never fail with \r\n errors
*.sh text eol=lf
*.bash text eol=lf
entrypoint.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
